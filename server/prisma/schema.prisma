generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  STAFF
  DRIVER
}

enum Plan {
  TRIAL
  BASIC
  PRO
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum Unit {
  KG
  BOX
  PIECE
  BAG
  CARTON
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  WASTE
}

enum OrderStatus {
  PENDING
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STAFF)
  active       Boolean  @default(true)
  // Custom permissions picked by an admin (a list of keys, see lib/permissions.js); null = the role's defaults
  permissions  Json?
  // Set when the password is reset; sessions issued before this moment stop working
  passwordChangedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  passwordResetTokens PasswordResetToken[]
  customersCreated Customer[]      @relation("CustomerCreatedBy")
  ordersCreated    Order[]         @relation("OrderCreatedBy")
  stockMovements   StockMovement[] @relation("StockMovementCreatedBy")
  paymentsRecorded Payment[]       @relation("PaymentCreatedBy")
  activityLogs     ActivityLog[]
  orderAssignments Order[]        @relation("OrderDriver")
  expensesCreated  Expense[]      @relation("ExpenseCreatedBy")

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

// The taxes a company charges on its sales (e.g. GST 5, QST 9.975). A rate is a percentage.
model Tax {
  id        String   @id @default(cuid())
  name      String
  rate      Decimal  @db.Decimal(7, 4)
  number    String? // the company's registration number for this tax, printed on invoices
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId])
}

// Extra barcodes for the same item (a retail code, a case code, a supplier's code ...).
// The product's main barcode stays on Product.barcode.
model ProductBarcode {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  code      String
  label     String? // e.g. "Case label", "Supplier Acme"
  createdAt DateTime @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
  @@index([productId])
  @@index([tenantId])
}

// One-time password reset links. Only a hash of the token is stored.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Customer {
  id           String   @id @default(cuid())
  name         String
  phone        String?
  address      String?
  businessName String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdById String?
  createdBy   User?   @relation("CustomerCreatedBy", fields: [createdById], references: [id])

  orders        Order[]
  customPrices  CustomerPrice[]

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model Product {
  id                String   @id @default(cuid())
  name              String
  category          String
  unit              Unit     @default(KG)
  costPrice         Decimal  @db.Decimal(10, 2)
  sellingPrice      Decimal  @db.Decimal(10, 2)
  stockQty          Decimal  @default(0) @db.Decimal(10, 2)
  lowStockThreshold Decimal  @default(10) @db.Decimal(10, 2)
  active            Boolean  @default(true)
  barcode           String?
  taxable           Boolean  @default(true)
  color             String? // label color picked in the product form (a key such as "red"), null = automatic
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  orderItems     OrderItem[]
  stockMovements StockMovement[]
  customPrices   CustomerPrice[]
  barcodes       ProductBarcode[]

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@unique([tenantId, barcode])
}

model CustomerPrice {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  unitPrice  Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([customerId, productId])
}

model StockMovement {
  id        String            @id @default(cuid())
  productId String
  product   Product           @relation(fields: [productId], references: [id])
  type      StockMovementType
  quantity  Decimal           @db.Decimal(10, 2)
  reason    String?
  orderId   String?
  order     Order?            @relation(fields: [orderId], references: [id])
  createdAt DateTime          @default(now())

  createdById String?
  createdBy   User?   @relation("StockMovementCreatedBy", fields: [createdById], references: [id])

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model Order {
  id          String        @id @default(cuid())
  orderNumber String
  customerId  String
  customer    Customer      @relation(fields: [customerId], references: [id])
  status      OrderStatus   @default(PENDING)
  discount    Decimal       @default(0) @db.Decimal(10, 2)
  deliveryFee Decimal       @default(0) @db.Decimal(10, 2)
  subtotal    Decimal       @default(0) @db.Decimal(10, 2)
  // tax charged on this order, copied at the time so later rate changes don't alter it
  taxTotal    Decimal       @default(0) @db.Decimal(10, 2)
  taxes       Json? // [{ name, rate, base, amount }]; null = no taxes were set up when it was created
  total       Decimal       @default(0) @db.Decimal(10, 2)
  notes       String?
  paymentStatus PaymentStatus @default(UNPAID)
  amountPaid  Decimal       @default(0) @db.Decimal(10, 2)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  createdById String?
  createdBy   User?   @relation("OrderCreatedBy", fields: [createdById], references: [id])

  assignedDriverId String?
  assignedDriver   User?   @relation("OrderDriver", fields: [assignedDriverId], references: [id], onDelete: SetNull)
  deliveryNotes    String?

  items          OrderItem[]
  stockMovements StockMovement[]
  payments       Payment[]

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@unique([tenantId, orderNumber])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Decimal @db.Decimal(10, 2)
  unitPrice Decimal @db.Decimal(10, 2)
  lineTotal Decimal @db.Decimal(10, 2)
}

model Payment {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(10, 2)
  note      String?
  createdAt DateTime @default(now())

  createdById String?
  createdBy   User?   @relation("PaymentCreatedBy", fields: [createdById], references: [id])
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  details    String?
  createdAt  DateTime @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model Supplier {
  id            String   @id @default(cuid())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  products       Product[]
  stockMovements StockMovement[]

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

enum ExpenseCategory {
  FUEL
  RENT
  SALARIES
  UTILITIES
  OTHER
}

model Expense {
  id        String          @id @default(cuid())
  date      DateTime
  category  ExpenseCategory
  amount    Decimal         @db.Decimal(10, 2) // what was paid, tax included
  // the tax contained in that amount: [{ name, amount }]; null = not recorded
  taxTotal  Decimal         @default(0) @db.Decimal(10, 2)
  taxes     Json?
  note      String?
  createdAt DateTime        @default(now())

  createdById String?
  createdBy   User?   @relation("ExpenseCreatedBy", fields: [createdById], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model Setting {
  id                       String   @id @default(cuid())
  companyName              String   @default("Viandes Corona")
  address                  String?
  phone                    String?
  email                    String?
  invoicePrefix            String   @default("ORD")
  currency                 String   @default("CAD")
  defaultLowStockThreshold Decimal  @default(10) @db.Decimal(10, 2)
  taxRate                  Decimal  @default(0) @db.Decimal(5, 4)
  updatedAt                DateTime @updatedAt

  // Admin-designed invoice layout (blocks, order, columns, colors). null = built-in default.
  invoiceLayout Json?

  // Variable-weight barcode parsing (scale-printed labels encoding an item
  // code + weight in one barcode, common for meat/deli). Positions are
  // 0-based digit offsets into the scanned code.
  variableWeightEnabled      Boolean @default(false)
  variableWeightPrefix       String  @default("2")
  variableWeightItemStart    Int     @default(1)
  variableWeightItemLength   Int     @default(5)
  variableWeightWeightStart  Int     @default(6)
  variableWeightWeightLength Int     @default(5)
  variableWeightDecimals     Int     @default(3)
  variableWeightUnit         String  @default("kg")

  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id])
}

model Tenant {
  id        String       @id @default(cuid())
  name      String
  plan      Plan         @default(TRIAL)
  status    TenantStatus @default(ACTIVE)
  // null = never expires
  expiresAt DateTime?
  maxUsers  Int          @default(3)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users          User[]
  customers      Customer[]
  products       Product[]
  productBarcodes ProductBarcode[]
  taxes          Tax[]
  stockMovements StockMovement[]
  orders         Order[]
  activityLogs   ActivityLog[]
  suppliers      Supplier[]
  expenses       Expense[]
  setting        Setting?
}
