DATABASE_URL="postgresql://user:password@localhost:5432/viandes_corona_admin"
JWT_SECRET="change-this-to-a-long-random-string-in-production"
JWT_EXPIRES_IN="12h"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# Platform owner login (creates a SUPER_ADMIN on boot if missing) - manages every client's license
SUPERADMIN_EMAIL="owner@yourcompany.com"
SUPERADMIN_PASSWORD="choose-a-long-password"

# Password reset emails (the "Forgot password?" link on the login page).
# Public address of the web app, used to build the link in the email (defaults to the first CLIENT_ORIGIN)
# APP_URL="https://your-app-domain"
# Sender shown on the email
# MAIL_FROM="Inventra <no-reply@yourdomain.com>"
# Option 1: any SMTP server (e.g. Gmail with an app password, Outlook, Brevo, your host)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="you@gmail.com"
# SMTP_PASS="your-app-password"
# Option 2: Resend (https://resend.com). The sender domain must be verified to email anyone
# RESEND_API_KEY="re_..."
# With neither option set, the reset link is printed in the server log instead of emailed.
